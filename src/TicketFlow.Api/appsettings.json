{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}      {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "SeedDemoData": true
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=ticketflow.db",
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "TicketFlow",
    "Audience": "TicketFlow.Clients",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Ticketing": {
    "ReservationHoldMinutes": 10,
    "MaxTicketsPerOrder": 10,
    "Currency": "TRY",
    "EnableExpirationWorker": true,
    "ExpirationSweepSeconds": 30
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "OrdersTokenLimit": 20,
    "OrdersTokensPerMinute": 20
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  }
}
